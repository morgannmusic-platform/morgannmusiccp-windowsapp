{
  "name": "morgann-music-cp",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.morgannmusic.cp",
    "productName": "Morgann Music CP",
    "copyright": "Copyright © 2026 Morgann Music CP",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.js",
      "index.html",
      "preload.js",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/img/icons/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/img/icons/icon.icns"
    },
    "publish": {
      "provider": "github",
      "owner": "VOTRE_PSEUDO_GITHUB",
      "repo": "NOM_DU_REPO_GITHUB"
    }
  },
  "dependencies": {
    "electron": "^45.1.0"
  },
  "devDependencies": {
    "electron-builder": "^26.18.0"
  }
}
